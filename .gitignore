# Root level gitignore for entire project

# Backend - Maven
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar

# Backend - IDE
backend/.idea/
backend/*.iml
backend/.classpath
backend/.project
backend/.settings/

# Frontend - Flutter/Dart
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/pubspec.lock
frontend/build/
frontend/.flutter-plugins-dependencies

# Frontend - IDE
frontend/.idea/
frontend/*.iml

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db

# Environment files
.env
.env.local
**/.env
**/application-local.properties
